# ─── 生产环境配置模板 ──────────────────────────────────────
# 复制此文件为 .env.production 使用
# cp .env.production.example .env.production

# 运行模式
NODE_ENV=production

# API 基础路径
VITE_API_BASE_URL=/api

# 应用标题（浏览器标签页 + PWA 名称）
VITE_APP_TITLE=vant-starter-kit

# 应用基础路径
VITE_PUBLIC_PATH=/

# 环境名称
VITE_ENV_NAME=production

# 是否启用 vConsole 调试面板（生产环境建议关闭，或通过 ?vconsole 按需开启）
VITE_ENABLE_VCONSOLE=false
