# ─── 开发环境配置模板 ──────────────────────────────────────
# 复制此文件为 .env.development 使用
# cp .env.development.example .env.development

# 运行模式
NODE_ENV=development

# API 基础路径
VITE_API_BASE_URL=/api

# 腾讯云 IM 应用 ID
VITE_TCC_APP_ID=

# Dev Server 主机地址
VITE_DEV_SERVER_HOST=0.0.0.0

# 环境名称
VITE_ENV_NAME=development

# 应用标题
VITE_APP_TITLE=vant-starter-kit

# 应用基础路径
VITE_PUBLIC_PATH=/

# 是否启用 vConsole 调试面板
VITE_ENABLE_VCONSOLE=true
