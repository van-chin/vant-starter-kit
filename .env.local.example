# ─── 本地开发 HTTPS 代理配置 ───────────────────────────────
# 复制此文件为 .env.local 使用
# cp .env.local.example .env.local
#
# unplugin-https-reverse-proxy 插件通过 Caddy Server 实现
# 本地 HTTPS 反向代理，将 vant.starter.kit.inlin.test 的请求
# 转发到本地开发服务器，解决 PWA / 微信支付 等需要 HTTPS 的场景

# HTTPS 反向代理目标域名（与 /etc/hosts 中配置一致）
VITE_PROXY_TARGET=vant.starter.kit.inlin.test

# 允许的 Host 域名
VITE_ALLOWED_HOST=vant.starter.kit.inlin.test

# Caddy Server 安装路径（可选，默认为 ~/tmp/.uhrp）
# UHRP_CADDY_PATH=~/tmp/.uhrp
