# ─── 应用配置 ──────────────────────────────────────────────

# API 基础路径
VITE_API_BASE_URL=/api

# 腾讯云 IM 应用 ID（可留空）
VITE_TCC_APP_ID=

# 应用标题（显示在浏览器标签页和 PWA 名称中）
VITE_APP_TITLE=vant-starter-kit

# 应用基础路径
VITE_PUBLIC_PATH=/

# 环境名称
VITE_ENV_NAME=development

# ─── 开发服务器 ────────────────────────────────────────────

# Dev Server 主机地址
VITE_DEV_SERVER_HOST=0.0.0.0

# 允许的 Host 域名（开发环境）
VITE_ALLOWED_HOST=

# HTTPS 反向代理目标域名
VITE_PROXY_TARGET=

# ─── 调试 ──────────────────────────────────────────────────

# 是否启用 vConsole 调试面板（true=始终启用，空=通过 ?vconsole 参数按需启用）
VITE_ENABLE_VCONSOLE=
