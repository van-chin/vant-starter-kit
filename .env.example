# ⚠️ 新增/删除环境变量时，必须同步以下文件：
#   1. env.d.ts —— TypeScript 类型声明
#   2. src/composables/useEnv.ts —— 类型安全访问 + 默认值
#   3. 本文件（.env.example）—— 变量文档模板
#   4. .env / .env.development / .env.production —— 各环境的实际值
#
# Vite 只暴露 VITE_ 前缀的变量到客户端（import.meta.env）
# 非 VITE_ 前缀的变量仅在 vite.config.ts 等服务端代码中可用

# ─── 应用配置 ──────────────────────────────────────────────

# API 基础路径
VITE_API_BASE_URL=/api

# 腾讯云 IM 应用 ID（可留空）
VITE_TCC_APP_ID=

# 应用标题（显示在浏览器标签页和 PWA 名称中）
VITE_APP_TITLE=vant-starter-kit

# 应用基础路径
VITE_PUBLIC_PATH=/

# 环境名称（development / test / production）
VITE_ENV_NAME=development

# ─── 开发服务器 ────────────────────────────────────────────

# Dev Server 主机地址
VITE_DEV_SERVER_HOST=0.0.0.0

# 允许的 Host 域名（开发环境）
VITE_ALLOWED_HOST=

# HTTPS 反向代理目标域名（开发环境）
VITE_PROXY_TARGET=

# ─── 调试 ──────────────────────────────────────────────────

# 是否启用 vConsole 调试面板
#   true — 始终启用（所有环境）
#   空/未设置 — 仅在 URL 带 ?vconsole 参数时启用
VITE_ENABLE_VCONSOLE=

# ─── 外部 API（可选，支持多个）─────────────────────────────

# 命名规范：VITE_EXTERNAL_API_<NAME>=<URL>
# 开发环境：Vite 自动将 /api-external-<name> 代理到对应 URL（解决跨域）
# 使用方式：import { getExternalAlova } from '@/api/external'
#
# VITE_EXTERNAL_API_OTHER=http://www.xxx.com/api
# VITE_EXTERNAL_API_THIRD=http://www.yyy.com/v1
