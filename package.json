{
  "name": "vant-starter-kit",
  "version": "0.0.2",
  "private": true,
  "description": "基于 Vue 3 + Vant 4 + Vite+ 的移动端 H5 / PWA 极速启动模板 — App Shell 布局、深色模式、PWA 完整集成、多后端 API 支持、Cloudflare Workers 一键部署",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#build": "./build/index.ts"
  },
  "scripts": {
    "build": "vp build && vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.vitest.json && vue-tsc --noEmit -p tsconfig.node.json",
    "dev": "vp dev",
    "prepare": "vp config",
    "preview": "vp preview",
    "pwa:assets:generator": "vp exec pwa-assets-generator",
    "release": "bumpp",
    "syncpack:fix": "syncpack fix",
    "syncpack:format": "syncpack format",
    "syncpack:lint": "syncpack lint",
    "syncpack:list": "syncpack list",
    "syncpack:update": "syncpack update",
    "taze": "vpx taze",
    "wrangler:deploy": "vp dlx wrangler deploy",
    "wrangler:login": "vp dlx wrangler login"
  },
  "dependencies": {
    "@alova/adapter-axios": "catalog:",
    "@fontsource-variable/noto-sans-sc": "catalog:",
    "@unhead/vue": "catalog:",
    "@vueuse/core": "catalog:",
    "alova": "catalog:",
    "dayjs": "catalog:",
    "nitro": "catalog:",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "tailwindcss": "catalog:",
    "vant": "catalog:",
    "vconsole": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@vant/auto-import-resolver": "catalog:",
    "@vant/touch-emulator": "catalog:",
    "@vite-pwa/assets-generator": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "bumpp": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "syncpack": "catalog:",
    "typescript": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-https-reverse-proxy": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vite-plugin-vue-layouts-next": "catalog:",
    "vite-plus": "catalog:",
    "vue-i18n": "catalog:",
    "vue-tsc": "catalog:",
    "workbox-build": "catalog:",
    "workbox-window": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
